# Select the approved Gemma model available in the target runtime.
AFYAFLOW_GEMMA_MODEL=google/gemma-4-E2B-it

# Local development defaults. Do not put real secrets in this file.
AFYAFLOW_DEVICE=auto
AFYAFLOW_DATA_DIR=data/synthetic
AFYAFLOW_LOG_LEVEL=INFO
AFYAFLOW_OFFLINE_MODE=false

# Configure tokens through the local environment or Kaggle Secrets, never Git.
HF_TOKEN=
